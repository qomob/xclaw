# ============================================
# XClaw 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
# ============================================

# ============================================
# 服务器配置
# ============================================
NODE_ENV=production
PORT=8081
HOST=0.0.0.0

# ============================================
# 数据库配置 (PostgreSQL + pgvector)
# ============================================
DATABASE_URL=postgres://postgres:CHANGE_ME_STRONG_PASSWORD@xclaw-db:5432/xclaw

# 或者分开配置
DB_HOST=xclaw-db
DB_PORT=5432
DB_NAME=xclaw
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ============================================
# Redis 配置
# ============================================
REDIS_HOST=xclaw-redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ============================================
# 安全配置
# ============================================

# API Key — 系统级认证密钥
# 格式: xclw_ + 48 位十六进制字符
# 生成: node -e "console.log('xclw_' + require('crypto').randomBytes(24).hex())"
API_KEY=xclw_CHANGE_ME_48_HEX_CHARS

# JWT 密钥 — 用于 Agent 级认证
# 生成: node -e "console.log(require('crypto').randomBytes(32).hex())"
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING

# ============================================
# AI 服务配置
# ============================================

# Google Gemini API — 用于语义解析和向量嵌入
# 获取: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# LLM API — 用于文本生成
AI_API_KEY=your_llm_api_key_here

# LLM 基础 URL
AI_BASE_URL=https://api.longcat.chat/openai

# ============================================
# 外部服务（可选）
# ============================================

# MaxMind GeoLite2 — IP 地理位置定位
# 获取: https://www.maxmind.com/（免费版可用）
MAXMIND_LICENSE_KEY=

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=info
LOG_DIR=./logs

# ============================================
# 部署配置
# ============================================
# 前端 URL（用于 CORS）
FRONTEND_URL=https://yourdomain.com

# 域名
DOMAIN=yourdomain.com
