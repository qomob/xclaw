# ============================================
# XClaw 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
# ============================================

# ============================================
# 服务器配置
# ============================================
NODE_ENV=production
PORT=8081
HOST=0.0.0.0

# ============================================
# 数据库配置 (PostgreSQL + pgvector)
# ============================================
DATABASE_URL=postgres://postgres:CHANGE_ME_STRONG_PASSWORD@xclaw-db:5432/xclaw

# 或者分开配置
DB_HOST=xclaw-db
DB_PORT=5432
DB_NAME=xclaw
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ============================================
# Redis 配置
# ============================================
REDIS_HOST=xclaw-redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ============================================
# 安全配置
# ============================================

# API Key — 系统级认证密钥
# 格式: xclw_ + 48 位十六进制字符
# 生成: node -e "console.log('xclw_' + require('crypto').randomBytes(24).toString('hex'))"
API_KEY=xclw_CHANGE_ME_48_HEX_CHARS

# Admin API Key — 管理台/管理接口专用密钥，必须与 API_KEY 不同！
# 未设置时所有 /v1/admin/* 接口一律 403（不会回退到 API_KEY）
# 生成: node -e "console.log('xclw_' + require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=xclw_CHANGE_ME_DIFFERENT_48_HEX

# Monitor WebSocket 令牌 — 未设置时 monitor 连接将被拒绝（不能留空上线）
MONITOR_TOKEN=CHANGE_ME_32_HEX

# JWT 密钥 — 用于 Agent 级认证
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING

# 数据加密主密钥 — 离线消息等敏感数据加密；一旦产生加密数据后不可更换
ENCRYPTION_KEY=CHANGE_ME_64_CHAR_RANDOM_STRING

# 联邦/跨链共享密钥 — 多实例互联时须一致（建议独立于 API_KEY）
FEDERATION_KEY=xclw_fed_CHANGE_ME_48_HEX_CHARS
# 联邦/跨链出站路径前缀：默认 /api 兼容 nginx 反代；对端为直连后端时设为空
FEDERATION_PATH_PREFIX=/api

# ============================================
# AI 服务配置
# ============================================

# LLM API — 用于文本生成与向量嵌入（OpenAI 兼容协议）
# LLM 与 Embedding 的 OpenAI 兼容凭据（Embedding 缺省回落 AI_API_KEY）
# 注意：Embedding 模型输出维度必须为 768（text-embedding-004），否则语义搜索静默失败
AI_API_KEY=your_llm_api_key_here
# AI_EMBEDDING_API_KEY=
# AI_EMBEDDING_MODEL=text-embedding-004
# AI_EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# LLM 基础 URL
AI_BASE_URL=https://api.longcat.chat/openai

# ============================================
# 外部服务（可选）
# ============================================

# Temporal 服务地址（可选，未配置时任务系统降级为 Redis 轮询）
TEMPORAL_ADDRESS=localhost:7233

# MaxMind GeoLite2 — IP 地理位置定位
# 获取: https://www.maxmind.com/（免费版可用）
MAXMIND_LICENSE_KEY=

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=info
LOG_DIR=./logs

# ============================================
# 实时通道限制（生产安全）
# ============================================
# /ws 最大连接数（默认 500）
WS_MAX_CONNECTIONS=500
# /ws 单客户端消息频率限制（窗口内条数 / 窗口毫秒）
WS_MSG_RATE_LIMIT=60
WS_MSG_RATE_WINDOW_MS=10000

# ============================================
# 告警与可观测性
# ============================================
# 告警检查周期（毫秒）与冷却（毫秒）
ALERT_CHECK_INTERVAL=60000
ALERT_COOLDOWN_MS=600000
# 真实告警通知 Webhook（如企业微信群机器人/钉钉/Slack）
ALERT_WEBHOOK_URL=
# 指标快照落库周期（毫秒）
METRICS_SNAPSHOT_INTERVAL=60000

# ============================================
# 维护 Worker（独立进程）
# ============================================
MAINT_REPUTATION_INTERVAL=1800000
MAINT_DECAY_INTERVAL=3600000
MAINT_CLEANUP_INTERVAL=86400000

# ============================================
# 可信结算（Escrow + 验收 + 争议）
# ============================================
# 执行方提交结果后的调用方验收窗口（小时），超时自动放行
TASK_VERIFICATION_HOURS=24
# 维护 Worker 检查验收超时的周期（毫秒）
VERIFICATION_PROCESS_INTERVAL=60000

# ============================================
# 备份（db-backup 服务 / backup-cron.sh 使用）
# ============================================
# 生成: openssl rand -hex 32；启用 db-backup 服务（--profile backup）时必填
BACKUP_ENCRYPTION_KEY=
# 备份间隔秒数（默认 86400 = 每日一次）
BACKUP_INTERVAL_SECONDS=86400
# 可选：加密备份的异地上传命令，以 "$1" = 加密文件路径 调用
# 例: rclone copy $1 remote:xclaw-backups/  或  scp $1 backup@nas:/volume1/xclaw/
BACKUP_UPLOAD_CMD=

# ============================================
# 多实例部署标识（水平扩展）
# ============================================
# 每个后端实例唯一；未设置时自动生成随机值
INSTANCE_ID=

# ============================================
# 提现执行器（外部链上广播服务，见 docs/withdrawal-executor.md）
# ============================================
# 外部广播服务地址（留空 = dry-run，提现标记为需人工处理）
WITHDRAWAL_EXECUTOR_URL=
# 派发请求 HMAC 签名密钥（与服务端约定）
WITHDRAWAL_EXECUTOR_SECRET=
# 回调验签密钥（默认回退 EXECUTOR_SECRET；建议独立）
WITHDRAWAL_CALLBACK_SECRET=
# 派发超时（毫秒）
WITHDRAWAL_EXECUTOR_TIMEOUT=30000

# ============================================
# 部署配置
# ============================================
# 前端 URL（用于 CORS）
FRONTEND_URL=https://yourdomain.com
# 对外访问地址（注册时生成 Agent 的 WebSocket 地址）
PUBLIC_URL=https://yourdomain.com
WS_PUBLIC_URL=wss://yourdomain.com

# 域名
DOMAIN=yourdomain.com

# ============================================
# docker-compose 专用（compose 内服务的互联凭据）
# ============================================
# 未设置时 compose 拒绝启动（不再回退到公开默认密码）
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ============================================
# 网络与联邦
# ============================================
# 本实例网络标识（联邦多实例时各不相同）
NETWORK_ID=default
# 本实例后端对内地址（联邦心跳上报用）
LOCAL_ENDPOINT=http://backend:8081

# ============================================
# CORS 与实时通道限制（后端主 WSS）
# ============================================
# 允许的浏览器来源，逗号分隔；留空使用默认 xclaw.network 域名
CORS_ORIGINS=
# 主 WSS 全局消息限流（窗口内条数 / 窗口毫秒）
WS_RATE_LIMIT=240
WS_RATE_WINDOW_MS=60000
